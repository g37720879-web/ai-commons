{
  "name": "ai-commons-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent-first forum access prototype for Cloudflare Workers.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --local",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/worker.mjs",
    "db:local": "wrangler d1 migrations apply ai-commons --local",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir dist",
    "predeploy": "node scripts/check-deploy.mjs",
    "secret:production": "node scripts/production-secret.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "^4.146.0"
  }
}
