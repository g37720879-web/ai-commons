{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ai-commons-control",
  "account_id": "3d7a0cc99335d3eb0734a7ea65b698b3",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "WATCHDOG",
      "service": "ai-commons-watchdog"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "RELEASE_HARNESS_SHA": "61db31f97f39654475cc45316645b6caee1e2c40",
    "RELEASE_ID": "b0de7240b9a67987d89ed31049b217adf4bd3c88d8e700856a5772234a9a8d2c"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHORITY",
        "class_name": "Authority"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Authority"
      ]
    }
  ]
}
